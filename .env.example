# =============================================================================
# BACKEND ONLY — photo_global_backend (API server)
# =============================================================================
# Copy to .env in THIS repo.
#
# Frontend .env files live in OTHER repos:
#   docs/env.main-frontend.example  → gidtransfer.com (photographers)
#   docs/env.admin-frontend.example → separate admin frontend project
# =============================================================================

PORT=7100
NODE_ENV=development

MONGO_URL=mongodb://127.0.0.1:27017/photo_global_database
# Optional MongoDB connection pool tuning
# MONGO_MAX_POOL_SIZE=20
# MONGO_MIN_POOL_SIZE=2
# MONGO_MAX_IDLE_MS=30000
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=45000

# -----------------------------------------------------------------------------
# Auth (backend only — never expose in frontend .env)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Cache authenticated user/admin lookups (ms, default 60000)
# AUTH_CACHE_TTL_MS=60000
# Cache gallery tab counts per owner (ms, default 30000)
# GALLERY_COUNTS_CACHE_TTL_MS=30000

# -----------------------------------------------------------------------------
# Frontend URLs (backend references — NOT the frontend .env files)
# -----------------------------------------------------------------------------
# MAIN app public URL: emails, gallery share links, password reset, Paystack callback
APP_URL=http://localhost:3000
# Production: https://gidtransfer.com

# Public HTTPS URL of THIS API (email images, absolute media links)
API_PUBLIC_URL=http://127.0.0.1:7100
# Production: https://api.gidtransfer.com

# Browser origins allowed to call this API (REQUIRED in production).
# Main app (gidtransfer.com) plus your admin app's deployed origin:
CORS_ORIGINS=
# Production example:
# CORS_ORIGINS=https://gidtransfer.com,https://www.gidtransfer.com

# Google OAuth — must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in MAIN frontend only
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Admin user seed (backend only — `node scripts/createAdmin.js`)
# NOT for the admin frontend .env
# -----------------------------------------------------------------------------
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Platform Admin

# -----------------------------------------------------------------------------
# Performance / sync (backend tuning)
# -----------------------------------------------------------------------------
# Log requests slower than this threshold (ms, default 200)
# SLOW_REQUEST_MS=200
# Set to 0 to disable Server-Timing response header
# REQUEST_TIMING_HEADER=1
# Minimum response size before gzip compression (bytes, default 1024)
# COMPRESSION_THRESHOLD_BYTES=1024
# SYNC_REVISION_CACHE_TTL_MS=5000
# SYNC_CHANGES_LIMIT=200
# SSE_HEARTBEAT_MS=25000

# -----------------------------------------------------------------------------
# Integrations (backend only)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional model for gallery description text (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Client gallery AI selection — vision analysis + smart pick suggestions (default: on when OPENAI_API_KEY is set)
# GALLERY_AI_SELECTION_ENABLED=true
# OPENAI_VISION_MODEL=gpt-4o-mini
# Concurrent AI analysis jobs (default 1 — vision calls are rate/cost sensitive)
# GALLERY_AI_QUEUE_CONCURRENCY=1

ARKESEL_API_KEY=
ARKESEL_DEFAULT_SENDER=Gidtransfer
# ARKESEL_SMS_DRY_RUN=true
# ARKESEL_API_URL=https://sms.arkesel.com/api/v2/sms/send

RESEND_API_KEY=
RESEND_FROM_EMAIL=Gidtransfer <notifications@yourdomain.com>
# RESEND_FROM_NAME=Gidtransfer
# RESEND_EMAIL_DRY_RUN=true
# EMAIL_NOTIFICATIONS_ENABLED=true
# SMS_NOTIFICATIONS_ENABLED=true
# BOOKING_DAY_REMINDER_HOURS_BEFORE=24
# BOOKING_HOUR_REMINDER_HOURS_BEFORE=1
# BOOKING_REMINDER_CHECK_MINUTES=15
# BILLING_RENEWAL_REMINDER_DAYS_BEFORE=10
# BILLING_RENEWAL_REMINDER_CHECK_HOURS=6

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Run `node scripts/createPaystackPlans.js` after adding PAYSTACK_SECRET_KEY.
# Plans: free (trial) | basic GHS 40 | pro GHS 70 | premium GHS 120.
# Paystack charges the amount stored on each PLN_* plan — recreate plans after price changes.
PAYSTACK_PLAN_BASIC=
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_PREMIUM=
# Legacy aliases (optional; same codes as BASIC / PREMIUM if you still use them):
# PAYSTACK_PLAN_STARTER=
# PAYSTACK_PLAN_BUSINESS=
# PAYSTACK_PLAN_STUDIO=
# Optional: post-payment redirect (default: APP_URL/billing/callback)
# PAYSTACK_CALLBACK_URL=http://localhost:3000/billing/callback

S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 bucket CORS must allow PUT from MAIN frontend origin (gidtransfer.com)
# DERIVATIVE_QUEUE_CONCURRENCY=2
# Optional grid thumbnails (progressive JPEG). Default 800 when unset; set 0 to disable.
# GALLERY_THUMB_MAX_PX=800
# GALLERY_THUMB_JPEG_QUALITY=82
# GALLERY_PREVIEW_JPEG_QUALITY=90
# GALLERY_PREVIEW_JPEG_QUALITY=90
# S3_PUBLIC_URL=https://cdn.example.com

# -----------------------------------------------------------------------------
# Video streaming (FFmpeg MPEG-DASH) — adaptive playback on changing networks
# -----------------------------------------------------------------------------
# Requires ffmpeg on PATH (or set FFMPEG_PATH). Default: enabled when ffmpeg works.
# GALLERY_VIDEO_DASH_ENABLED=true
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# Concurrent DASH encodes (default 1 — CPU heavy)
# VIDEO_DASH_QUEUE_CONCURRENCY=1
# Skip DASH when source is larger than this (bytes, default 2147483648 = 2GiB)
# GALLERY_VIDEO_DASH_MAX_BYTES=2147483648
# Bitrate ladder height:kbps (default 360:800,720:1800,1080:3500)
# GALLERY_VIDEO_DASH_LADDER=360:800,720:1800,1080:3500
# GALLERY_VIDEO_DASH_SEG_DURATION=4
# GALLERY_VIDEO_DASH_TIMEOUT_MS=2700000

# -----------------------------------------------------------------------------
# OpenSearch (optional search layer — Mongo remains source of truth)
# -----------------------------------------------------------------------------
# When unset / disabled, gallery/client/photo search falls back to Mongo regex.
# Local:
#   docker run -d --name opensearch -p 9200:9200 -e discovery.type=single-node \
#     -e DISABLE_SECURITY_PLUGIN=true -e OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m" \
#     opensearchproject/opensearch:2.19.1
# OPENSEARCH_ENABLED=true
# OPENSEARCH_NODE=http://127.0.0.1:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_SSL_REJECT_UNAUTHORIZED=true
# OPENSEARCH_PHOTO_INDEX=photo_global_photos
# OPENSEARCH_GALLERY_INDEX=photo_global_galleries
# OPENSEARCH_CLIENT_INDEX=photo_global_clients
# After enabling against existing data: node scripts/reindexOpensearch.js
